# Copy this file to .env and fill in your values.
# These variables are exposed to the browser at build time (Vite only injects vars prefixed with VITE_).

# Public URL where the site is hosted (optional, used for self-referential links).
# Example for GitHub Pages user site: https://<owner>.github.io
# Example for project site: https://<owner>.github.io/<repo>
VITE_APP_URL=""
